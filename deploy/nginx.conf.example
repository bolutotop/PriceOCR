# Nginx 反代配置示例（PriceOCR · 轮询模式）
#
# 仅需把 80（或 443）的流量反代到 127.0.0.1:3100（Next.js 主应用）。
# 因为是轮询模式，**不需要 webhook 路径**。
#
# 用法（HTTP 简版，无域名也能用）：
#   1. cp deploy/nginx.conf.example /etc/nginx/sites-available/priceocr.conf
#   2. ln -s /etc/nginx/sites-available/priceocr.conf /etc/nginx/sites-enabled/
#   3. 把 server_name 改为你的 IP 或域名
#   4. nginx -t && systemctl reload nginx
#
# 如有域名：
#   sudo certbot --nginx -d your-domain.com   # 自动签发 HTTPS
# =============================================================================

server {
    listen 80;
    # 没有域名就写下划线（默认匹配所有未命中其它 server 的请求）
    # 有域名：填 your-domain.com
    server_name _;

    # 反馈图、价格表截图等上传：放宽 body 上限
    client_max_body_size 30M;

    # ----- Next.js 主应用 -----
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # OCR 图片上传可能较慢，超时调大
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # 静态资源走长缓存
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_cache_valid 200 30d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}

