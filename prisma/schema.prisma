generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 开发阶段推荐用 sqlite，上线可换 postgresql
  url      = env("DATABASE_URL")
}

// 1. 香烟基础库 (彻底抛弃地区标签，回归极简)
model Product {
  id           String         @id @default(cuid())
  name         String         @unique
  alias        String?        // 别名，用于 OCR 容错匹配
  
  // 别名映射关系表，挂载在这个商品下所有的异名
  aliases      ProductAlias[]

  // 价格历史记录
  priceHistory PriceItem[] 
}

// 1.5 别名库 (用于自动识别快递名与广货名不同时)
model ProductAlias {
  id        String   @id @default(cuid())
  name      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// 2. 报价单/批次 (一次上传对应一个批次)
model PriceSheet {
  id         String      @id @default(cuid())
  title      String?     // 可选标题，例如 "晚班报价"
  
  // --- 核心新增：行情标签 ---
  marketType String      // 行情区分："EXPRESS" (快递行情) 或 "GUANGHUO" (广货行情)
  
  // --- 时间线 ---
  createdAt  DateTime    @default(now()) // 系统记录时间 (你什么时候点的保存)
  recordDate DateTime    @default(now()) // 业务行情时间 (这张表是哪天的价格) -> 用于画折线图
  
  items      PriceItem[]
}

// 3. 具体价格条目
model PriceItem {
  id         String      @id @default(cuid())
  price      Float
  
  // 属于哪张单子
  sheetId    String
  sheet      PriceSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  // 属于哪个产品 (允许为空，防报错)
  productId  String?    
  product    Product?    @relation(fields: [productId], references: [id])

  // 冗余存一个名字，方便直接查询显示
  rawName    String     
}

// 4. 手工库存表 (独立于比价系统，自己填写的库存)
model InventoryItem {
  id        String   @id @default(cuid())
  name      String   // 名称
  price     Float    // 单价
  quantity  Int      // 数量
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// 5. 用户问题反馈
//    用户可以提交问题描述 + 截图，开发者把它标记为已修复，
//    用户在问题看板上点"确认完成"后才真正删除并清理图片。
model Issue {
  id          String    @id @default(cuid())
  description String    // 问题文字描述
  // 图片相对路径列表，JSON 编码（SQLite 没有原生数组）。
  // 例如：["/issue-uploads/<id>/abc.jpg", "/issue-uploads/<id>/def.png"]
  imagesJson  String    @default("[]")
  // OPEN / RESOLVED
  status      String    @default("OPEN")
  // 提交者标识（可选，浏览器临时 ID，用于"自己只能确认自己提的问题"等约束；当前不强制）
  reporter    String?
  // 开发者修复时的备注，用户能看到
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}
